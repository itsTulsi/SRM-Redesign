# Public URL used for canonical / hreflang / sitemap links (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://srm-nextgen.vercel.app

# Optional. Enables Claude explanations in /api/ask. Without it the matcher falls back to Fuse.js results.
ANTHROPIC_API_KEY=

# Optional. Where admission enquiries are forwarded (JSON POST): a CRM/Sheets/email webhook.
# Without it the enquiry form runs in demo mode and says so.
ENQUIRY_WEBHOOK_URL=

# Optional free AI for "Ask SRM" (questions the rules can't answer). Any OpenAI-compatible endpoint works:
# Groq free tier (https://api.groq.com/openai/v1), Google Gemini's OpenAI-compatible endpoint, OpenRouter free
# models, or a local Ollama (http://localhost:11434/v1). Pick a model from that provider's free list.
# Leave all three empty and the assistant stays fully rule-based (still free, still works offline).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Tested with Groq: LLM_BASE_URL=https://api.groq.com/openai/v1 and LLM_MODEL=openai/gpt-oss-20b
