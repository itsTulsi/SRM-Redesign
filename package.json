{
  "name": "srm-nextgen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mts",
    "prebuild": "npm run check:content",
    "build:verify": "NEXT_DIST_DIR=.next-verify next build",
    "start:verify": "NEXT_DIST_DIR=.next-verify next start"
  },
  "dependencies": {
    "fuse.js": "7.5.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "next": "15.5.28",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
